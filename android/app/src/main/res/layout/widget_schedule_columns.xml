<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_container"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Minimal 1-line Header (no squishing "неделя" badge) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/anthropic_serif"
                android:text="@string/group_name"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_week_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_badge_pill"
                android:paddingStart="5dp"
                android:paddingTop="1dp"
                android:paddingEnd="5dp"
                android:paddingBottom="1dp"
                android:singleLine="true"
                android:text="10 нед."
                android:textColor="@color/accent_primary"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_header_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/anthropic_serif"
                android:text="Сегодня"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_refresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_badge_number"
            android:contentDescription="@string/refresh"
            android:padding="4dp"
            android:src="@drawable/ic_refresh" />
    </RelativeLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layout_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/anthropic_serif"
            android:text="@string/no_pairs_today"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Horizontal Columns of Pairs (Guaranteed 100% visible, zero blank ListView bugs) -->
    <LinearLayout
        android:id="@+id/layout_columns"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Column 1 -->
        <LinearLayout
            android:id="@+id/slot_col_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_pair_item"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/col1_tv_num"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/bg_badge_number"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/badge_number_text"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/col1_tv_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="08:00–09:20"
                    android:textColor="@color/text_time"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/col1_tv_abbr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/anthropic_serif"
                android:text="УП"
                android:textColor="@color/accent_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/col1_tv_subject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="@font/anthropic_serif"
                android:gravity="center"
                android:maxLines="2"
                android:text="Уголовное право"
                android:textColor="@color/text_primary"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/col1_tv_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="каб. 402"
                android:textColor="@color/text_room"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Column 2 -->
        <LinearLayout
            android:id="@+id/slot_col_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_pair_item"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/col2_tv_num"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/bg_badge_number"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/badge_number_text"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/col2_tv_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="09:30–10:50"
                    android:textColor="@color/text_time"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/col2_tv_abbr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/anthropic_serif"
                android:text="УП"
                android:textColor="@color/accent_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/col2_tv_subject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="@font/anthropic_serif"
                android:gravity="center"
                android:maxLines="2"
                android:text="Уголовное право"
                android:textColor="@color/text_primary"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/col2_tv_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="каб. 202"
                android:textColor="@color/text_room"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Column 3 -->
        <LinearLayout
            android:id="@+id/slot_col_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_pair_item"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/col3_tv_num"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/bg_badge_number"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/badge_number_text"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/col3_tv_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="11:10–12:30"
                    android:textColor="@color/text_time"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/col3_tv_abbr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/anthropic_serif"
                android:text="СПП"
                android:textColor="@color/accent_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/col3_tv_subject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="@font/anthropic_serif"
                android:gravity="center"
                android:maxLines="2"
                android:text="Спец. подготовка"
                android:textColor="@color/text_primary"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/col3_tv_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="каб. 103"
                android:textColor="@color/text_room"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Column 4 -->
        <LinearLayout
            android:id="@+id/slot_col_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_pair_item"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/col4_tv_num"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/bg_badge_number"
                    android:gravity="center"
                    android:text="4"
                    android:textColor="@color/badge_number_text"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/col4_tv_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="12:40–14:00"
                    android:textColor="@color/text_time"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/col4_tv_abbr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/anthropic_serif"
                android:text="СПП"
                android:textColor="@color/accent_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/col4_tv_subject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="@font/anthropic_serif"
                android:gravity="center"
                android:maxLines="2"
                android:text="Спец. подготовка"
                android:textColor="@color/text_primary"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/col4_tv_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="каб. 103"
                android:textColor="@color/text_room"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
